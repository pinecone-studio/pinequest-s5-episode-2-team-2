{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "studio.pinecone.pinequest.team2",
      "infoPlist": {
        "NSCameraUsageDescription": "TODO(copy): \u041d\u04af\u0434\u043d\u0438\u0439 \u0448\u0430\u043b\u0433\u0430\u043b\u0442\u044b\u043d \u0442\u0443\u0440\u0448\u0438\u043b\u0442\u0430\u0434 \u043a\u0430\u043c\u0435\u0440 \u0430\u0448\u0438\u0433\u043b\u0430\u0445 \u0437\u04e9\u0432\u0448\u04e9\u04e9\u0440\u04e9\u043b \u04e9\u0433\u043d\u04e9 \u04af\u04af. \u0417\u0443\u0440\u0430\u0433 \u0445\u0430\u0434\u0433\u0430\u043b\u0430\u0445\u0433\u04af\u0439."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "studio.pinecone.pinequest.team2",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "pinequest",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Nunito_500Medium.ttf",
            "./assets/fonts/Nunito_700Bold.ttf",
            "./assets/fonts/Nunito_800ExtraBold.ttf",
            "./assets/fonts/Nunito_900Black.ttf"
          ]
        }
      ]
    ]
  }
}
