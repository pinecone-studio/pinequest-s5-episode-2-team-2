{
  "expo": {
    "name": "Нүдний гэрэл",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "studio.pinecone.pinequest.team2",
      "infoPlist": {
        "NSCameraUsageDescription": "Нүдний шалгалт хийхэд камер ашиглана. Зураг хадгалахгүй, утаснаас гаргахгүй."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F7FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "studio.pinecone.pinequest.team2",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "pinequest",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Nunito_500Medium.ttf",
            "./assets/fonts/Nunito_700Bold.ttf",
            "./assets/fonts/Nunito_800ExtraBold.ttf",
            "./assets/fonts/Nunito_900Black.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7FF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
